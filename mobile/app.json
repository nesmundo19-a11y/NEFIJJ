{
  "expo": {
    "name": "NEFIJJ",
    "slug": "nefijj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NEFIJJ necesita acceso a tus fotos para adjuntar evidencia a un reporte.",
          "cameraPermission": "NEFIJJ necesita acceso a la cámara para tomar evidencia de un reporte.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
